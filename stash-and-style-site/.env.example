# Copy to .env.local and fill in what you need. The site runs with NONE of these set.

# Public URL of the site (canonical links, sitemap, Open Graph). Defaults to https://stashandstyle.store
NEXT_PUBLIC_SITE_URL=

# "true" shows 12 clearly-labelled placeholder products so you can judge grids, filters and the cart.
# Demo mode also makes every page noindex. Never deploy with this on.
NEXT_PUBLIC_DEMO_MODE=false

# Google Tag Manager container (e.g. GTM-M5WLLMXV). Only loads after a visitor accepts the cookie banner.
NEXT_PUBLIC_GTM_ID=

# Shopify Storefront API. When BOTH are set, the catalog and checkout come from Shopify.
# See docs/CONNECT-SHOPIFY.md. Server-side only — never prefix these with NEXT_PUBLIC_.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Optional, defaults to 2026-07
SHOPIFY_API_VERSION=

# Set to 1 to make the build FAIL while any [REPLACE BEFORE LAUNCH] markers remain.
PRELAUNCH_STRICT=
